<!--pages/knowledge/knowledge.wxml-->
<view class="container">
  <view class="header">
    <view class="title">我的知识库</view>
    <view class="add-btn" bindtap="showAddModal">+ 添加</view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索知识点..." bindinput="onSearch" />
  </view>

  <view class="category-tabs">
    <view class="tab {{currentTab === item ? 'active' : ''}}" 
          wx:for="{{categories}}" wx:key="*this"
          bindtap="switchTab" data-tab="{{item}}">
      {{item}}
    </view>
  </view>

  <view class="list">
    <view class="item" wx:for="{{knowledgeList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="item-header">
        <view class="item-title">{{item.title}}</view>
        <view class="item-category">{{item.category}}</view>
      </view>
      <view class="item-content">{{item.content}}</view>
      <view class="item-footer">
        <view class="item-time">{{item.createTimeStr}}</view>
        <view class="item-actions">
          <view class="action-btn" catchtap="editItem" data-id="{{item._id}}">编辑</view>
          <view class="action-btn delete" catchtap="deleteItem" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{knowledgeList.length === 0}}">
      <view class="empty-icon">📝</view>
      <view class="empty-text">暂无知识点，点击右上角添加</view>
    </view>
  </view>
</view>

<!-- 添加/编辑弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-title">{{editId ? '编辑知识点' : '添加知识点'}}</view>
    <view class="form-item">
      <input class="input" placeholder="请输入标题" value="{{form.title}}" bindinput="onInput" data-field="title" />
    </view>
    <view class="form-item">
      <picker mode="selector" range="{{categories}}" range-key="*this" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{form.category || '选择分类'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <textarea class="textarea" placeholder="请输入知识点内容..." value="{{form.content}}" bindinput="onInput" data-field="content" maxlength="5000" />
    </view>
    <view class="modal-btns">
      <view class="btn cancel" bindtap="hideModal">取消</view>
      <view class="btn confirm" bindtap="saveKnowledge">保存</view>
    </view>
  </view>
</view>
