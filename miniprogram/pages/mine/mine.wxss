/* pages/mine/mine.wxss */
.container {
  padding: 0 0 120rpx 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  padding: 60rpx 40rpx;
}

.profile-section {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-right: 30rpx;
  background: #eee;
}

.profile-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.profile-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.stats-card {
  display: flex;
  background: #fff;
  margin: -30rpx 30rpx 30rpx;
  padding: 40rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 10;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A90D9;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f7fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.share-btn {
  margin: 40rpx 30rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}
