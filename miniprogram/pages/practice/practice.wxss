/* pages/practice/practice.wxss */
.container {
  padding: 0 0 120rpx 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  padding: 40rpx;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.config-card {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.config-item {
  margin-bottom: 30rpx;
}

.config-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.picker {
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #999;
}

.count-selector {
  display: flex;
  gap: 20rpx;
}

.count-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.count-btn.active {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}

.start-btn {
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.practice-area {
  padding: 0 30rpx;
}

.progress {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.question-type {
  display: inline-block;
  font-size: 22rpx;
  color: #4A90D9;
  background: #eef5ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.options {
  margin-bottom: 30rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
}

.option.selected {
  border-color: #4A90D9;
  background: #eef5ff;
}

.option.correct {
  border-color: #67c23a;
  background: #f0fff4;
}

.option.wrong {
  border-color: #f56c6c;
  background: #fff0f0;
}

.option-label {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 50%;
  margin-right: 20rpx;
  font-weight: bold;
  color: #666;
}

.option.selected .option-label {
  background: #4A90D9;
  color: #fff;
}

.answer-input {
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 10rpx;
  height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}

.action-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #4A90D9;
  color: #fff;
}

.btn.next {
  background: #67c23a;
}

.answer-card {
  margin-top: 30rpx;
  padding: 30rpx;
  background: #f0fff4;
  border-radius: 10rpx;
}

.answer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #67c23a;
  margin-bottom: 15rpx;
}

.answer-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.answer-explain {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ddd;
}

.explain-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #999;
  margin-bottom: 10rpx;
}

.explain-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.complete-card {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.complete-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.complete-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.complete-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.complete-btn {
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  color: #fff;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.complete-btn.secondary {
  background: #fff;
  color: #4A90D9;
  border: 1rpx solid #4A90D9;
}
