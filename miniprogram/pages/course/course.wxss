/* pages/course/course.wxss */
.container {
  padding: 0 0 120rpx 0;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  padding: 40rpx;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.course-list {
  padding: 30rpx;
}

.course-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.course-cover {
  height: 300rpx;
  background: linear-gradient(135deg, #4A90D9, #67B8F7);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 20rpx;
}

.course-price {
  background: #ff6b6b;
  color: #fff;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.course-info {
  padding: 30rpx;
}

.course-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.course-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.course-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.course-buy {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}
